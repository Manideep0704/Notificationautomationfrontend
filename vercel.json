{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://apiautomation.iryax.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://apiautomation.iryax.com/auth/:path*" },
    { "source": "/health", "destination": "https://apiautomation.iryax.com/health" },
    { "source": "/webhook/:path*", "destination": "https://apiautomation.iryax.com/webhook/:path*" },
    { "source": "/login", "destination": "/login.html" }
  ]
}

